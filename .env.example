# מסד הנתונים בענן (Turso). בלי השורות האלה האתר משתמש בקובץ data/hapoel.db,
# שמתמלא לבד מ-data/seed.json בפעם הראשונה.
# באוויר הן מוגדרות ב-Vercel וב-GitHub Actions, לא כאן.
# TURSO_DATABASE_URL=libsql://hrgsite-<user>.turso.io
# TURSO_AUTH_TOKEN=

# אופציונלי: נתיב לדפדפן כרום קיים, במקום ההתקנה של Playwright (בשביל קהל ושופט)
# CHROMIUM_PATH=

# תקצירים מיוטיוב: מפתח חינמי של YouTube Data API v3 (Google Cloud Console > Credentials).
# באוויר הוא מוגדר כ-secret ב-GitHub Actions. בלי מפתח האתר פשוט לא מציג תקצירים.
# YOUTUBE_API_KEY=
