# פורט השרת במחשב
PORT=3001
# false כדי לכבות את השגרות האוטומטיות במחשב (למשל בפיתוח)
ENABLE_JOBS=true

# מסד הנתונים בענן (Turso). בלי השורות האלה השרת משתמש בקובץ data/hapoel.db.
# באוויר הן מוגדרות ב-Vercel וב-GitHub Actions, לא כאן.
# TURSO_DATABASE_URL=libsql://hrgsite-<user>.turso.io
# TURSO_AUTH_TOKEN=
